# PAGDOC development template — copy locally to .env and never commit the real file.
# Generate unique random values locally. Do not reuse these placeholders.
PAGDOC_ENVIRONMENT=development
PAGDOC_SECRET_KEY=REPLACE_WITH_A_RANDOM_SECRET_OF_AT_LEAST_32_CHARACTERS

# Fernet key used to encrypt MFA secrets and private prototype objects at rest.
# Generate locally with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
PAGDOC_ENCRYPTION_KEY=REPLACE_WITH_A_UNIQUE_FERNET_KEY

# Local development may use SQLite. Staging/production are blocked unless PostgreSQL is configured.
PAGDOC_DATABASE_URL=sqlite:///./pagdoc_dev.sqlite3

# Required for staging/production and must be HTTPS. Leave empty in local development.
PAGDOC_PUBLIC_ORIGIN=

# Session and login-abuse controls.
PAGDOC_SESSION_SECONDS=3600
PAGDOC_LOGIN_WINDOW_MINUTES=15
PAGDOC_LOGIN_MAX_FAILURES=5

# Prototype encrypted-object size limit. Binary upload HTTP routes remain disabled.
PAGDOC_MAX_UPLOAD_BYTES=52428800

# Only set to YES when intentionally running bootstrap_demo.py with fictitious data.
PAGDOC_ALLOW_DEMO_BOOTSTRAP=NO
